<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
  <title>FN SISTEM · Expediente Clínico</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', system-ui, sans-serif;
      background: linear-gradient(145deg, #f7f9fc 0%, #eef2f6 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      margin: 0;
    }

    /* animación de entrada general */
    @keyframes fadeSlideUp {
      0% {
        opacity: 0;
        transform: translateY(30px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .main-container {
      width: 100%;
      max-width: 1100px;
      animation: fadeSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* tarjeta principal con efecto perlado */
    .clinical-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      background: linear-gradient(135deg, #ffffff 0%, #f5f7fd 100%);
      border-radius: 2.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 20, 60, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(173, 192, 230, 0.4);
      padding: 2rem 2rem 2.2rem;
      transition: all 0.2s ease;
    }

    /* Encabezado con animación del nombre */
    .brand-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .fn-letters {
      font-size: 2.8rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #0b2b5e, #1f4e8c);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 4px 6px rgba(0,80,150,0.2));
      animation: softGlow 2s infinite alternate;
    }

    @keyframes softGlow {
      0% { filter: drop-shadow(0 4px 8px rgba(0,112,184,0.2)); }
      100% { filter: drop-shadow(0 6px 14px rgba(0,112,184,0.4)); }
    }

    .sistem-text {
      font-size: 1.4rem;
      font-weight: 400;
      color: #1f4e8c;
      letter-spacing: 0.3rem;
      text-transform: uppercase;
      margin-left: 0.2rem;
    }

    .folder-manager {
      display: flex;
      gap: 0.7rem;
      align-items: center;
    }

    .btn-add-folder {
      background: #ffffff;
      border: 1px solid #cbd6e8;
      color: #1f4e8c;
      font-weight: 600;
      padding: 0.7rem 1.4rem;
      border-radius: 3rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(255,255,255,0.7);
      backdrop-filter: blur(5px);
      box-shadow: 0 4px 10px rgba(0,32,64,0.08);
      cursor: pointer;
      transition: 0.25s;
      font-size: 0.9rem;
    }

    .btn-add-folder:hover {
      background: white;
      border-color: #1f4e8c;
      box-shadow: 0 10px 18px -8px rgba(20,80,150,0.3);
      transform: scale(1.02);
    }

