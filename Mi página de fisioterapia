      margin-bottom: 1.8rem;
      align-items: center;
    }

    .folder-tab {
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(8px);
      border: 1px solid #cfdef5;
      padding: 0.5rem 1.4rem;
      border-radius: 2.5rem;
      font-weight: 600;
      color: #103a5c;
      cursor: pointer;
      transition: 0.2s;
      display: flex;
